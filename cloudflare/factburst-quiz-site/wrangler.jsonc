{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "factburst-quiz-site",
  "main": "worker-entry.js",
  "compatibility_date": "2026-08-27",
  "keep_vars": true,
  "workers_dev": true,
  "routes": [
    {
      "pattern": "factburstquiz.com",
      "custom_domain": true
    }
  ],
  "vars": {
    "EMAIL_FROM": "noreply@factburstquiz.com"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/quiz",
      "/quiz/*",
      "/quiz.html",
      "/quizzes",
      "/quizzes/*",
      "/quizzes.html",
      "/profile",
      "/profile.html",
      "/leaderboard",
      "/leaderboard.html",
      "/terms",
      "/terms.html",
      "/privacy",
      "/privacy.html",
      "/robots.txt",
      "/sitemap.xml",
      "/social/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "QUIZ_IMAGES",
      "bucket_name": "factburst-quiz-images"
    }
  ]
}