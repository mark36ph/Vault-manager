<Window x:Class="FactVaultManager.Desktop.ProductionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FactVaultManager"
        Height="780" Width="1120"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#101318"
        Foreground="#F4F6F8">

    <Window.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="#171B22" />
            <Setter Property="BorderBrush" Value="#2B313B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#232A34" />
            <Setter Property="Foreground" Value="#F4F6F8" />
            <Setter Property="BorderBrush" Value="#343C48" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="MinHeight" Value="42" />
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#321C20" />
            <Setter Property="BorderBrush" Value="#6B2934" />
            <Setter Property="Foreground" Value="#FFB4BC" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D1015" />
            <Setter Property="Foreground" Value="#DDE3EA" />
            <Setter Property="BorderBrush" Value="#2B313B" />
            <Setter Property="CaretBrush" Value="White" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="FactVaultManager" FontSize="28" FontWeight="Bold" />
                <TextBlock Text="Production workspace" Margin="0,3,0,0" Foreground="#8E98A7" FontSize="13" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="WorkerStatusText" Text="Connecting..." HorizontalAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock x:Name="UpdateStatusText" Text="Updates: development build" HorizontalAlignment="Right" Margin="0,3,0,0" Foreground="#8E98A7" FontSize="12" />
                    <TextBlock x:Name="RepositoryText" Visibility="Collapsed" />
                </StackPanel>
                <Button x:Name="CheckUpdatesButton" Content="Check for Updates" Margin="0,0,8,0" Click="CheckUpdates_Click" />
                <Button x:Name="RefreshProjectsButton" Content="Refresh" Click="RefreshProjects_Click" IsEnabled="False" />
            </StackPanel>
        </Grid>

        <!-- Project and actions -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,22,0">
                    <TextBlock Text="PROJECT" Foreground="#8E98A7" FontSize="11" FontWeight="Bold" Margin="0,0,0,7" />
                    <ComboBox x:Name="ProjectComboBox"
                              IsEnabled="False"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="ProjectComboBox_SelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,22,0">
                    <TextBlock x:Name="ProjectStatusText" Text="Loading projects..." FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="ProjectFolderText" Margin="0,6,0,0" Foreground="#8E98A7" FontSize="12" TextWrapping="Wrap" MaxWidth="520" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ProductionActionButton"
                            Style="{StaticResource PrimaryButton}"
                            Content="Produce Video"
                            Margin="0,0,8,0"
                            Click="ProductionAction_Click"
                            IsEnabled="False" />
                    <Button x:Name="ResumeProductionButton"
                            Content="Resume"
                            Margin="0,0,8,0"
                            Click="ResumeProduction_Click"
                            IsEnabled="False" />
                    <Button x:Name="CancelProductionButton"
                            Style="{StaticResource DangerButton}"
                            Content="Cancel"
                            Click="CancelProduction_Click"
                            IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="PRODUCTION" Foreground="#8E98A7" FontSize="11" FontWeight="Bold" Margin="0,0,0,6" />
                    <TextBlock x:Name="CurrentStageText" Text="Production ready" FontSize="15" FontWeight="SemiBold" />
                    <ProgressBar x:Name="ProductionProgressBar"
                                 Height="10"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Margin="0,12,22,0" />
                </StackPanel>

                <TextBlock x:Name="ProductionProgressText"
                           Grid.Column="1"
                           Text="0%"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#93B4FF"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Log -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Production log" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Live messages from the Python production engine" Margin="0,3,0,0" Foreground="#8E98A7" FontSize="12" />
                    </StackPanel>
                    <Button Content="Clear Log" Padding="12,6" DockPanel.Dock="Right" Click="ClearLog_Click" />
                </DockPanel>

                <TextBox x:Name="LogTextBox"
                         Grid.Row="1"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12.5"
                         Padding="12"
                         BorderThickness="1" />
            </Grid>
        </Border>
    </Grid>
</Window>
