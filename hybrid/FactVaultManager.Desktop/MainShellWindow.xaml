<Window x:Class="FactVaultManager.Desktop.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Factburst Quiz Manager" Icon="Assets/FactVaultManager.ico"
        Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" Foreground="#1F1F1F"
        FontFamily="Segoe UI Variable Text" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="PaneBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#FDA29B" />
        </Style>
        <Style x:Key="YouTubeManagerTabButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Background" Value="#0D124E" />
            <Setter Property="Foreground" Value="#BED2FF" />
            <Setter Property="BorderBrush" Value="#293A8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Background" Value="#1956AA" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#00CCFF" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2473D4" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#00CCFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F4C97" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="5,1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="#344054" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F2F4F7" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavSeparatorStyle" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="MinWidth" Value="196" />
            <Setter Property="Background" Value="#E1E1E1" />
            <Setter Property="Margin" Value="12,12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#C8CDD5" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#C8CDD5" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#C8CDD5" />
        </Style>
        <Style x:Key="DarkQuizComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#142048" />
            <Setter Property="Foreground" Value="#E1EBFF" />
            <Setter Property="BorderBrush" Value="#4669B4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Outer" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                                <Grid>
                                    <ContentPresenter x:Name="ContentSite" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="9,4,38,4" VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" MinHeight="0" Margin="9,4,38,4" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}" CaretBrush="#00CCFF" Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center" Visibility="Collapsed" />
                                    <ToggleButton Style="{x:Null}" Width="34" HorizontalAlignment="Right" Focusable="False" ClickMode="Press" Foreground="#FFCA2D" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent"><TextBlock Text="▼" Foreground="{TemplateBinding Foreground}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PopupAnimation="Fade">
                                <Border Background="#0D124E" BorderBrush="#00CCFF" BorderThickness="1" MaxHeight="300" MinWidth="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource AncestorType={x:Type Popup}}}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter /></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True"><Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" /><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#00CCFF" /></Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Outer" Property="BorderBrush" Value="#00CCFF" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Outer" Property="Opacity" Value="0.6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type ComboBoxItem}">
                        <Setter Property="Background" Value="#0D124E" />
                        <Setter Property="Foreground" Value="#E1EBFF" />
                        <Setter Property="Padding" Value="9,6" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1956AA" /><Setter Property="Foreground" Value="White" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1956AA" /><Setter Property="Foreground" Value="White" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EAECF0" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FCFCFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FB" />
            <Setter Property="Foreground" Value="#475467" />
            <Setter Property="BorderBrush" Value="#EAECF0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF2FF" /></Trigger></Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HiddenPageTabStyle" TargetType="TabItem">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Width="0" Height="0" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionTabStyle" TargetType="TabItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="#F7F7F7" />
            <Setter Property="Foreground" Value="#475467" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#175CD3" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="Factburst Quiz Manager" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="HeaderStatusText" Text="Quizzes • Library • Uploads • Analytics • Website management" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="22,3,0,0" />
                <Button Grid.Column="2" Content="Updates" Click="CheckUpdates_Click" Margin="0" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#E1E1E1" BorderThickness="0,0,1,0">
                <StackPanel x:Name="PrimaryNavigationPanel" Margin="0,20,0,0">
                    <TextBlock Text="FACTBURST" Foreground="#777777" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,8" />
                    <!-- Bootstrap anchors are intentionally blank. Current feature initializers replace them before first paint. -->
                    <Button Tag="0" Visibility="Collapsed" />
                    <Button Tag="1" Visibility="Collapsed" />
                    <Button Tag="2" Visibility="Collapsed" />
                    <Button Tag="3" Visibility="Collapsed" />
                    <Button Tag="4" Visibility="Collapsed" />
                    <Border x:Name="SocialNavigationDivider" Style="{StaticResource NavSeparatorStyle}" Visibility="Collapsed" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="5" Click="Navigate_Click" Content="⚙   Settings" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="12" Margin="16">
                <TabControl x:Name="MainTabs" Background="#FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <!-- Reserved slots keep the Settings tab at its established index while current Factburst pages are appended. -->
                    <TabItem Style="{StaticResource HiddenPageTabStyle}" Visibility="Collapsed" />
                    <TabItem Style="{StaticResource HiddenPageTabStyle}" Visibility="Collapsed" />
                    <TabItem Style="{StaticResource HiddenPageTabStyle}" Visibility="Collapsed" />
                    <TabItem Style="{StaticResource HiddenPageTabStyle}" Visibility="Collapsed" />
                    <TabItem Style="{StaticResource HiddenPageTabStyle}" Visibility="Collapsed" />
                    <TabItem x:Name="SettingsTab" Style="{StaticResource HiddenPageTabStyle}" />
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
