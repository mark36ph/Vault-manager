<Window x:Class="FactVaultManager.Desktop.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FactVaultManager" Width="1320" Height="840" MinWidth="1080" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="#0F1115" Foreground="#F5F7FA">
    <Window.Resources>
        <SolidColorBrush x:Key="CardBrush" Color="#171A20" />
        <SolidColorBrush x:Key="BorderBrush" Color="#292D36" />
        <SolidColorBrush x:Key="MutedBrush" Color="#98A2B3" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="#242932" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#343A46" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="#3B82F6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#111419" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#343A46" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111419" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#111419" />
            <Setter Property="Foreground" Value="#F5F7FA" />
            <Setter Property="BorderBrush" Value="#292D36" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#242932" />
            <Setter Property="RowBackground" Value="#111419" />
            <Setter Property="AlternatingRowBackground" Value="#15191F" />
            <Setter Property="HeadersVisibility" Value="Column" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#15181E" BorderBrush="#292D36" BorderThickness="0,0,0,1">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FactVaultManager" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="HeaderStatusText" Text="C# desktop shell • Python production engine" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Check for Updates" Click="CheckUpdates_Click" />
                    <Button Content="Open Production" Style="{StaticResource PrimaryButton}" Click="OpenProduction_Click" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" Background="#0F1115" BorderThickness="0" Margin="18">
            <TabItem Header="Dashboard">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <TextBlock Text="Dashboard" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="Project overview and quick actions" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18" />
                        <UniformGrid Columns="5" Margin="0,0,0,18">
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="Total" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="TotalCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="In Progress" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="InProgressCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="Completed" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="CompletedCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,10,0"><StackPanel><TextBlock Text="Scheduled" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="ScheduledCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel><TextBlock Text="Published" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="PublishedCountText" Text="0" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Quick actions" FontSize="17" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button Content="Open Production" Style="{StaticResource PrimaryButton}" Click="OpenProduction_Click" />
                                    <Button Content="Refresh Dashboard" Click="RefreshAll_Click" />
                                    <Button Content="Go to Projects" Click="GoProjects_Click" />
                                    <Button Content="Go to Media" Click="GoMedia_Click" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Projects">
                <Grid Margin="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="410"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <TextBlock Text="Projects" FontSize="20" FontWeight="SemiBold" />
                            <Grid Grid.Row="1" Margin="0,12,0,12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="NewProjectTitleTextBox" Margin="0,0,8,0" ToolTip="New project title" />
                                <Button Grid.Column="1" Content="New Project" Style="{StaticResource PrimaryButton}" Click="CreateProject_Click" Margin="0" />
                            </Grid>
                            <DataGrid Grid.Row="2" x:Name="ProjectsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ProjectsGrid_SelectionChanged" AlternationCount="2">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock x:Name="ProjectEditorTitle" Text="Select a project" FontSize="22" FontWeight="SemiBold" />
                                <TextBlock x:Name="ProjectEditorFolderText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,16" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock Text="Category" Margin="0,0,0,5"/><TextBox x:Name="ProjectCategoryTextBox" /></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Status" Margin="0,0,0,5"/><ComboBox x:Name="ProjectStatusComboBox"><ComboBoxItem Content="Idea"/><ComboBoxItem Content="In Progress"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Scheduled"/><ComboBoxItem Content="Published"/></ComboBox></StackPanel>
                                </Grid>
                                <CheckBox x:Name="ProjectPinnedCheckBox" Content="Pinned" Margin="0,12,0,0" />
                                <TextBlock Text="Script" Margin="0,14,0,5"/><TextBox x:Name="ProjectScriptTextBox" MinHeight="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                                <TextBlock Text="Description" Margin="0,14,0,5"/><TextBox x:Name="ProjectDescriptionTextBox" MinHeight="70" AcceptsReturn="True" TextWrapping="Wrap"/>
                                <TextBlock Text="Pinned Comment" Margin="0,14,0,5"/><TextBox x:Name="ProjectPinnedCommentTextBox" MinHeight="60" AcceptsReturn="True" TextWrapping="Wrap"/>
                                <TextBlock Text="Tags" Margin="0,14,0,5"/><TextBox x:Name="ProjectTagsTextBox" />
                                <TextBlock Text="Notes" Margin="0,14,0,5"/><TextBox x:Name="ProjectNotesTextBox" MinHeight="90" AcceptsReturn="True" TextWrapping="Wrap"/>
                                <TextBlock Text="Sources" Margin="0,14,0,5"/><TextBox x:Name="ProjectSourcesTextBox" MinHeight="80" AcceptsReturn="True" TextWrapping="Wrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Save Project" Style="{StaticResource PrimaryButton}" Click="SaveProject_Click" />
                                    <Button Content="Apply Status" Click="ApplyStatus_Click" />
                                    <Button Content="Delete Project" Click="DeleteProject_Click" Margin="0" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Production">
                <Grid Margin="8">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" Width="620">
                        <StackPanel>
                            <TextBlock Text="Production" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="The production workflow is already native C#. Python is used only for the AI, asset verification, media preparation, narration, timeline and Resolve engine underneath." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,22" />
                            <Button Content="Open Production Workspace" Style="{StaticResource PrimaryButton}" Padding="20,12" Click="OpenProduction_Click" Margin="0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Media Library">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="MediaProjectComboBox" DisplayMemberPath="DisplayName" SelectionChanged="MediaProjectComboBox_SelectionChanged" />
                            <Button Grid.Column="1" Content="Refresh Media" Click="RefreshMedia_Click" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="MediaGrid" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="110" />
                            <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100" />
                            <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="160" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Asset Review">
                <Grid Margin="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="AssetProjectComboBox" DisplayMemberPath="DisplayName" SelectionChanged="AssetProjectComboBox_SelectionChanged" />
                            <Button Grid.Column="1" Content="Refresh Review" Click="RefreshAssetReview_Click" Margin="10,0,0,0" />
                        </Grid>
                    </Border>
                    <DataGrid Grid.Row="1" x:Name="AssetReviewGrid" AutoGenerateColumns="False" IsReadOnly="True" AlternationCount="2">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90" />
                            <DataGridTextColumn Header="Asset" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Scene / Context" Binding="{Binding Scene}" Width="3*" />
                            <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*" />
                            <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="8" MaxWidth="900" HorizontalAlignment="Left">
                        <StackPanel Width="820">
                            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="These settings are now edited directly by C#. The Python production engine reads the same settings file." Foreground="{StaticResource MutedBrush}" Margin="0,4,0,18" />
                            <TextBlock Text="Projects folder" Margin="0,0,0,5"/><TextBox x:Name="ProjectsFolderTextBox" />
                            <TextBlock Text="OpenAI API key" Margin="0,14,0,5"/><PasswordBox x:Name="OpenAiKeyPasswordBox" Background="#111419" Foreground="#F5F7FA" BorderBrush="#343A46" Padding="8,6" />
                            <TextBlock Text="OpenAI model" Margin="0,14,0,5"/><TextBox x:Name="OpenAiModelTextBox" />
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Pexels API key" Margin="0,0,0,5"/><PasswordBox x:Name="PexelsKeyPasswordBox" Background="#111419" Foreground="#F5F7FA" BorderBrush="#343A46" Padding="8,6"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Pixabay API key" Margin="0,0,0,5"/><PasswordBox x:Name="PixabayKeyPasswordBox" Background="#111419" Foreground="#F5F7FA" BorderBrush="#343A46" Padding="8,6"/></StackPanel>
                            </Grid>
                            <TextBlock Text="DaVinci Resolve path" Margin="0,14,0,5"/><TextBox x:Name="ResolvePathTextBox" />
                            <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Timeline width"/><TextBox x:Name="TimelineWidthTextBox" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Timeline height"/><TextBox x:Name="TimelineHeightTextBox" Margin="0,5,0,0"/></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Frame rate"/><TextBox x:Name="FrameRateTextBox" Margin="0,5,0,0"/></StackPanel>
                            </Grid>
                            <CheckBox x:Name="CheckUpdatesCheckBox" Content="Check for application updates" Margin="0,16,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="Save Settings" Style="{StaticResource PrimaryButton}" Click="SaveSettings_Click"/><TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/></StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
