<Window x:Class="FactVaultManager.Desktop.MainShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FactVaultManager" Width="1440" Height="900" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3" Foreground="#1F1F1F"
        FontFamily="Segoe UI Variable Text" FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F3F3F3" />
        <SolidColorBrush x:Key="PaneBrush" Color="#F7F7F7" />
        <SolidColorBrush x:Key="BorderBrush" Color="#E4E7EC" />
        <SolidColorBrush x:Key="MutedBrush" Color="#667085" />
        <SolidColorBrush x:Key="AccentBrush" Color="#0F6CBD" />

        <Style TargetType="Button">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#D0D5DD" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="#B42318" />
            <Setter Property="BorderBrush" Value="#FDA29B" />
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="5,1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Foreground" Value="#344054" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F2F4F7" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="PanelCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#C8CDD5" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#C8CDD5" />
            <Setter Property="Padding" Value="9,5" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="#C8CDD5" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="#EAECF0" />
            <Setter Property="RowBackground" Value="#FFFFFF" />
            <Setter Property="AlternatingRowBackground" Value="#FCFCFC" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F8F9FB" />
            <Setter Property="Foreground" Value="#475467" />
            <Setter Property="BorderBrush" Value="#EAECF0" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="#1F1F1F" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF2FF" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HiddenPageTabStyle" TargetType="TabItem">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Width="0" Height="0" /></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="SectionTabStyle" TargetType="TabItem">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Background" Value="#F7F7F7" />
            <Setter Property="Foreground" Value="#475467" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#FFFFFF" /><Setter Property="Foreground" Value="#175CD3" /><Setter Property="FontWeight" Value="SemiBold" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E1E1E1" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="FactVaultManager" FontFamily="Segoe UI Variable Display" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="HeaderStatusText" Text="C# desktop shell • Python production engine" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="22,3,0,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↻  Refresh" Click="RefreshAll_Click" />
                    <Button Content="Updates" Click="CheckUpdates_Click" />
                    <Button Content="▷  Production" Style="{StaticResource PrimaryButton}" Click="OpenProduction_Click" Margin="0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#E1E1E1" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,20,0,0">
                    <TextBlock Text="WORKSPACE" Foreground="#777777" FontSize="11" FontWeight="SemiBold" Margin="16,0,0,8" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="0" Click="Navigate_Click" Content="⌂   Dashboard" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="1" Click="Navigate_Click" Content="▤   Projects" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="2" Click="Navigate_Click" Content="▷   Production" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="3" Click="Navigate_Click" Content="□   Media Library" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="4" Click="Navigate_Click" Content="◉   Asset Review" />
                    <Border Height="1" Background="#E1E1E1" Margin="12,12" />
                    <Button Style="{StaticResource NavButtonStyle}" Tag="5" Click="Navigate_Click" Content="⚙   Settings" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#E1E1E1" BorderThickness="1" CornerRadius="12" Margin="16">
                <TabControl x:Name="MainTabs" Background="#FFFFFF" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <TabItem Style="{StaticResource HiddenPageTabStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="26,22,26,26">
                                <TextBlock Text="Dashboard" FontFamily="Segoe UI Variable Display" FontSize="30" FontWeight="SemiBold" />
                                <TextBlock Text="Overview of your content workspace" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,18" />
                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource StatCard}"><StackPanel><TextBlock x:Name="TotalCountText" Text="0" FontSize="26" FontWeight="Bold"/><TextBlock Text="Projects" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Grid.Column="1" Style="{StaticResource StatCard}"><StackPanel><TextBlock x:Name="InProgressCountText" Text="0" FontSize="26" FontWeight="Bold"/><TextBlock Text="In Progress" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Grid.Column="2" Style="{StaticResource StatCard}"><StackPanel><TextBlock x:Name="CompletedCountText" Text="0" FontSize="26" FontWeight="Bold"/><TextBlock Text="Completed" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Grid.Column="3" Style="{StaticResource StatCard}"><StackPanel><TextBlock x:Name="ScheduledCountText" Text="0" FontSize="26" FontWeight="Bold"/><TextBlock Text="Scheduled" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                                    <Border Grid.Column="4" Style="{StaticResource StatCard}" Margin="0"><StackPanel><TextBlock x:Name="PublishedCountText" Text="0" FontSize="26" FontWeight="Bold"/><TextBlock Text="Published" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border>
                                </Grid>
                                <TextBlock Text="Quick actions" FontSize="16" FontWeight="SemiBold" Margin="0,22,0,9" />
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Projects" Style="{StaticResource PrimaryButton}" Click="GoProjects_Click" />
                                    <Button Content="Production" Click="OpenProduction_Click" />
                                    <Button Content="Media Library" Click="GoMedia_Click" />
                                </StackPanel>
                                <Grid Margin="0,22,0,8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Recent projects" FontSize="16" FontWeight="SemiBold"/><Button Grid.Column="1" Content="View all  →" Click="GoProjects_Click" BorderThickness="0" Background="Transparent" Foreground="#175CD3"/></Grid>
                                <DataGrid ItemsSource="{Binding ItemsSource, ElementName=ProjectsGrid}" AutoGenerateColumns="False" IsReadOnly="True" MaxHeight="255">
                                    <DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/></DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Style="{StaticResource HiddenPageTabStyle}">
                        <Grid Margin="24,20,24,24">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Projects" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Find, review, and manage your content projects." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBox x:Name="NewProjectTitleTextBox" Width="280" Margin="0,0,8,0" ToolTip="New project title"/><Button Content="+  New project" Style="{StaticResource PrimaryButton}" Click="CreateProject_Click" Margin="0"/></StackPanel></Grid>
                            <Border Grid.Row="1" Style="{StaticResource PanelCard}" Margin="0,16,0,12" Padding="12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox ToolTip="Search by title or category" IsReadOnly="True" Text="Search and status filters will be added here" Foreground="#98A2B3"/><Button Grid.Column="1" Content="Refresh" Click="RefreshAll_Click" Margin="8,0,0,0"/></Grid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="All" Background="#EAF2FF" Foreground="#175CD3" BorderThickness="0"/><Button Content="In Progress" BorderThickness="0"/><Button Content="Scheduled" BorderThickness="0"/><Button Content="Completed" BorderThickness="0"/><Button Content="Published" BorderThickness="0"/></StackPanel></StackPanel></Border>
                            <TabControl Grid.Row="2" Background="#FFFFFF" BorderThickness="0">
                                <TabItem Header="Browse" Style="{StaticResource SectionTabStyle}">
                                    <DataGrid x:Name="ProjectsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionChanged="ProjectsGrid_SelectionChanged" Margin="0,12,0,0">
                                        <DataGrid.Columns><DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="2*"/><DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/><DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="150"/><DataGridCheckBoxColumn Header="Pinned" Binding="{Binding Pinned}" Width="80"/></DataGrid.Columns>
                                    </DataGrid>
                                </TabItem>
                                <TabItem Header="Edit selected" Style="{StaticResource SectionTabStyle}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="ProjectEditorTitle" Text="Select a project" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="ProjectEditorFolderText" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Save" Style="{StaticResource PrimaryButton}" Click="SaveProject_Click"/><Button Content="Apply status" Click="ApplyStatus_Click"/><Button Content="Delete" Style="{StaticResource DangerButton}" Click="DeleteProject_Click" Margin="0"/></StackPanel></Grid>
                                            <Border Height="1" Background="#EAECF0" Margin="0,0,0,14"/>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Category" Foreground="{StaticResource MutedBrush}" FontSize="11"/><TextBox x:Name="ProjectCategoryTextBox" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Status" Foreground="{StaticResource MutedBrush}" FontSize="11"/><ComboBox x:Name="ProjectStatusComboBox" Margin="0,4,0,0"><ComboBoxItem Content="Idea"/><ComboBoxItem Content="In Progress"/><ComboBoxItem Content="Completed"/><ComboBoxItem Content="Scheduled"/><ComboBoxItem Content="Published"/></ComboBox></StackPanel><CheckBox Grid.Column="4" x:Name="ProjectPinnedCheckBox" Content="Pinned" VerticalAlignment="Bottom" Margin="0,0,0,8"/></Grid>
                                            <TabControl Margin="0,16,0,0" Background="#FFFFFF" BorderBrush="#E4E7EC" BorderThickness="1"><TabItem Header="Content" Style="{StaticResource SectionTabStyle}"><StackPanel Margin="16"><TextBlock Text="Script" FontWeight="SemiBold"/><TextBox x:Name="ProjectScriptTextBox" Height="230" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5,0,14"/><TextBlock Text="Description" FontWeight="SemiBold"/><TextBox x:Name="ProjectDescriptionTextBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></TabItem><TabItem Header="Social" Style="{StaticResource SectionTabStyle}"><StackPanel Margin="16"><TextBlock Text="Pinned comment" FontWeight="SemiBold"/><TextBox x:Name="ProjectPinnedCommentTextBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,14"/><TextBlock Text="Tags" FontWeight="SemiBold"/><TextBox x:Name="ProjectTagsTextBox" Margin="0,5,0,0"/></StackPanel></TabItem><TabItem Header="Notes &amp; Sources" Style="{StaticResource SectionTabStyle}"><StackPanel Margin="16"><TextBlock Text="Notes" FontWeight="SemiBold"/><TextBox x:Name="ProjectNotesTextBox" Height="150" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,14"/><TextBlock Text="Sources" FontWeight="SemiBold"/><TextBox x:Name="ProjectSourcesTextBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></TabItem></TabControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>

                    <TabItem Style="{StaticResource HiddenPageTabStyle}">
                        <Grid Margin="26,22,26,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Production" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Build media, narration and timeline assets, then export to DaVinci Resolve Free." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,16"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="4*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="7*"/></Grid.ColumnDefinitions><Border Style="{StaticResource PanelCard}" Padding="16"><StackPanel><TextBlock Text="Setup" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="PROJECT" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,18,0,6"/><TextBlock Text="Choose the project, media providers, visual type and narration options in the production workspace." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="MEDIA" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,18,0,6"/><CheckBox Content="Pexels" IsChecked="True" IsEnabled="False" Margin="0,0,0,6"/><CheckBox Content="Pixabay" IsChecked="True" IsEnabled="False" Margin="0,0,0,6"/><CheckBox Content="Generate OpenAI narration" IsChecked="True" IsEnabled="False"/><TextBlock Text="ACTIONS" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="11" Margin="0,20,0,8"/><Button Content="▶ Open Production Workspace" Style="{StaticResource PrimaryButton}" Click="OpenProduction_Click" HorizontalAlignment="Stretch" Margin="0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ready" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Elapsed 00:00" Foreground="{StaticResource MutedBrush}" FontSize="11"/></StackPanel><TextBlock Grid.Column="1" Text="0%" FontSize="18" FontWeight="Bold" Foreground="#175CD3"/></Grid><ProgressBar Grid.Row="1" Height="8" Value="0" Margin="0,12,0,16"/><Border Grid.Row="2" Background="#F8F9FB" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="Workflow" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock Text="○  Research                         Waiting" Margin="0,4"/><TextBlock Text="○  Select Facts                     Waiting" Margin="0,4"/><TextBlock Text="○  Write Script                      Waiting" Margin="0,4"/><TextBlock Text="○  Find Visuals                      Waiting" Margin="0,4"/><TextBlock Text="○  Generate Voice                    Waiting" Margin="0,4"/><TextBlock Text="○  Build Timeline                    Waiting" Margin="0,4"/><TextBlock Text="○  Create Resolve Export             Waiting" Margin="0,4"/></StackPanel></Border><Border Grid.Row="3" Background="#F8F9FB" BorderBrush="#E4E7EC" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0"><StackPanel><TextBlock Text="Production log" FontWeight="SemiBold"/><TextBlock Text="Ready to start production." FontFamily="Consolas" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel></Border></Grid></Border></Grid></Grid>
                    </TabItem>

                    <TabItem Style="{StaticResource HiddenPageTabStyle}">
                        <Grid Margin="24,20,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Media Library" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Browse shared media and assets gathered by Production." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,14"/></StackPanel><Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox IsReadOnly="True" Text="Search media or project..." Foreground="#98A2B3"/><ComboBox Grid.Column="1" x:Name="MediaProjectComboBox" DisplayMemberPath="DisplayName" SelectionChanged="MediaProjectComboBox_SelectionChanged" Margin="8,0,0,0"/><Button Grid.Column="2" Content="Refresh" Click="RefreshMedia_Click" Margin="8,0,0,0"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="3*"/></Grid.ColumnDefinitions><DataGrid x:Name="MediaGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="90"/><DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="90"/><DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="140"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16"><StackPanel><TextBlock Text="Preview" FontSize="16" FontWeight="SemiBold"/><Border Background="#F8F9FB" BorderBrush="#EAECF0" BorderThickness="1" CornerRadius="6" Height="330" Margin="0,12,0,12"><TextBlock Text="Select an image or video to preview it." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Asset details" FontWeight="SemiBold"/><TextBlock Text="The C# media preview will be wired to the selected asset next." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Border></Grid></Grid>
                    </TabItem>

                    <TabItem Style="{StaticResource HiddenPageTabStyle}">
                        <Grid Margin="24,20,24,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Asset Review" FontFamily="Segoe UI Variable Display" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Review production assets and the scene context they were selected for." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,14"/></StackPanel><Grid Grid.Row="1" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="AssetProjectComboBox" DisplayMemberPath="DisplayName" SelectionChanged="AssetProjectComboBox_SelectionChanged"/><Button Grid.Column="1" Content="Refresh" Click="RefreshAssetReview_Click" Margin="8,0,0,0"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions><DataGrid x:Name="AssetReviewGrid" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="80"/><DataGridTextColumn Header="Asset" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Scene / context" Binding="{Binding Scene}" Width="2*"/><DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/></DataGrid.Columns></DataGrid><Border Grid.Column="2" Style="{StaticResource PanelCard}" Padding="16"><StackPanel><TextBlock Text="Review details" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Select an asset to inspect its source, scene context, verification notes and file location." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/></StackPanel></Border></Grid></Grid>
                    </TabItem>

                    <TabItem Style="{StaticResource HiddenPageTabStyle}">
