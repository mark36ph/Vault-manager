<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FactVaultManager.Desktop</RootNamespace>
    <AssemblyName>FactVaultManager.Desktop</AssemblyName>
    <AssemblyTitle>Factburst Quiz Manager</AssemblyTitle>
    <Product>Factburst Quiz Manager</Product>
    <StartupObject>FactVaultManager.Desktop.Program</StartupObject>
    <ApplicationIcon>Assets\FactVaultManager.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FactVaultManager.Desktop.Tests" />
    <Resource Include="Assets\FactVaultManager.ico" />
  </ItemGroup>
</Project>